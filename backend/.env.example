# ExpenseMate Backend Environment Variables Example

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Client Domain for CORS Security (Required in Production)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local Instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense_tracker?retryWrites=true&w=majority

# JWT Token Secret and Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Cloudinary Storage Configuration (Optional - for profile photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email OTP Service Configuration (Optional - for OTP verification)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
